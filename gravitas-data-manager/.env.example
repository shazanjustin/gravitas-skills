# Gravitas Data Manager — Local Credentials
# Copy to .env and fill in your values. .env is gitignored.
#
# Shared secrets (Apify, Meta tokens, Metricool) are fetched from
# gateway.shazan.me via the gravitas-gateway skill. Do NOT store them here.

# Supabase (Intel App database)
SUPABASE_URL=https://kzobygrjohvbuxiljbgk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Instaloader session for Instagram scraping (your own IG account)
# Run: pip install instaloader && instaloader --login
# Default path on Windows:
INSTALOADER_SESSION=C:/Users/dell/AppData/Local/Instaloader/session-_notakaki

# Output directory for generated files
IG_MANAGER_OUTPUT_DIR=outputs/gravitas-data-manager
