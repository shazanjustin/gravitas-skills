# Gravitas Skills — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never committed.

# === Shared secrets (fetched from gateway.shazan.me) ===
# Gateway API key (get from Shazan or your team lead)
GRAVITAS_GATEWAY_KEY=your-key-here

# Gateway URL (default, change only if self-hosting)
GRAVITAS_GATEWAY_URL=https://gateway.shazan.me

# Gateway WRITE key -- a different value from the read key above, not a mode of
# it. Needed to create or edit Performance rows (performance-tracker); the read
# key returns 401 on any write.
GRAVITAS_GATEWAY_WRITE_KEY=your-write-key-here

# Gateway ADMIN key -- a third distinct value. Only needed to add someone to the
# NocoDB Central base (nocodb-access). Kept separate from the write key on
# purpose: granting base membership is an authorization change, not a data edit,
# so it must not come free with the ability to edit a task row.
GRAVITAS_GATEWAY_ADMIN_KEY=your-admin-key-here

# === Per-user credentials (set up once locally) ===
# Instagram session for Instaloader scraping (your own IG account)
# Run: pip install instaloader && instaloader --login
# Session file will be at: ~/.config/instaloader/session-<your_username>
INSTALOADER_SESSION=~/.config/instaloader/session-your_username
