# Pitch Competitor Research — Local Credentials
# Copy to .env and fill in your values. .env is gitignored.
#
# Shared secrets (Metricool, Apify, Supabase) are fetched from
# gateway.shazan.me via gravitas-gateway.

# OpenRouter API key (for transcription + content analysis)
# Get from https://openrouter.ai/keys
# Supports Gemini, ChatGPT, Claude, etc. through a single endpoint.
OPENROUTER_API_KEY=your-openrouter-key

# Instaloader session for Instagram scraping
INSTALOADER_SESSION=C:/Users/dell/AppData/Local/Instaloader/session-_notakaki

# Output directory for pitch research results
PITCH_OUTPUT_DIR=outputs/pitch-research
